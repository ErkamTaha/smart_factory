# Smart Factory Backend - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to source control

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://smartfactory:CHANGE_ME@localhost:5432/smartfactory

# MQTT / EMQX
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=smartfactory
MQTT_PASSWORD=CHANGE_ME

# EMQX HTTP API
EMQX_API_URL=http://localhost:18083
EMQX_API_KEY=CHANGE_ME
EMQX_API_SECRET=CHANGE_ME

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
