# Smart Factory - Docker Compose Environment Variables
# Copy this file to .env and fill in secure values
# NEVER commit .env to source control
#
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# MQTT
MQTT_USERNAME=smartfactory
MQTT_PASSWORD=CHANGE_ME

# EMQX
EMQX_API_KEY=admin
EMQX_API_SECRET=CHANGE_ME
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
EMQX_NODE_COOKIE=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# Backend JWT Secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# pgAdmin
PGADMIN_PASSWORD=CHANGE_ME
